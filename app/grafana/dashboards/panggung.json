{
  "uid": "panggung-http",
  "title": "Panggung HTTP service",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Requests per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "panggung-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(panggung_http_requests_total[5m]))"}]
    },
    {
      "id": 2,
      "title": "Server errors per second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "panggung-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(rate(panggung_http_server_errors_total[5m]))"}]
    },
    {
      "id": 3,
      "title": "95th percentile request duration (seconds)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "panggung-prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(panggung_http_request_duration_seconds_bucket[5m])))"}]
    }
  ]
}
